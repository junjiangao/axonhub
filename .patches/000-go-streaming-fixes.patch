+func TestNormalizePassThroughResponseStatus(t *testing.T) {
+	t.Run("empty response status becomes in_progress", func(t *testing.T) {
+		ev := &httpclient.StreamEvent{
+			Data: json.RawMessage(`{"type":"response.created","sequence_number":0,"response":{"id":"resp_1","object":"response","created_at":1700000000,"status":"","model":"deepseek-v4-flash","output":[]}}`),
+		}
+
+		out := normalizePassThroughResponseStatus(ev)
+		require.NotSame(t, ev, out, "normalization must not mutate the original event")
+		require.Equal(t, "in_progress", gjson.GetBytes(out.Data, "response.status").String())
+		require.Equal(t, "resp_1", gjson.GetBytes(out.Data, "response.id").String())
+		require.Equal(t, "response.created", gjson.GetBytes(out.Data, "type").String())
+	})
