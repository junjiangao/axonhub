+func TestNormalizePassThroughFinishReason(t *testing.T) {
+	t.Run("empty finish_reason becomes null", func(t *testing.T) {
+		ev := &httpclient.StreamEvent{
+			Data: json.RawMessage(`{"id":"x","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"content":"hi"},"finish_reason":""}]}`),
+		}
+
+		out := normalizePassThroughFinishReason(ev)
+		require.NotSame(t, ev, out, "normalization must not mutate the original event")
+		require.Equal(t, gjson.Null, gjson.GetBytes(out.Data, "choices.0.finish_reason").Type)
+		require.Equal(t, "hi", gjson.GetBytes(out.Data, "choices.0.delta.content").String())
+	})
+
+	t.Run("valid finish_reason stays unchanged", func(t *testing.T) {
+		ev := &httpclient.StreamEvent{
+			Data: json.RawMessage(`{"id":"x","object":"chat.completion.chunk","choices":[{"index":0,"delta":{},"finish_reason":"stop"}]}`),
+		}
+
+		out := normalizePassThroughFinishReason(ev)
+		require.Same(t, ev, out)
+	})
+
+	t.Run("non chat-completion chunk stays unchanged", func(t *testing.T) {
+		ev := &httpclient.StreamEvent{
+			Data: json.RawMessage(`{"id":"x","object":"chat.completion","choices":[{"index":0,"message":{"content":"hi"},"finish_reason":""}]}`),
+		}
+
+		out := normalizePassThroughFinishReason(ev)
+		require.Same(t, ev, out)
+	})
+
+	t.Run("event without finish_reason field stays unchanged", func(t *testing.T) {
+		ev := &httpclient.StreamEvent{
+			Data: json.RawMessage(`{"id":"x","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"content":"hi"}}]}`),
+		}
+
+		out := normalizePassThroughFinishReason(ev)
+		require.Same(t, ev, out)
+	})
+
+	t.Run("multiple choices normalize only empty ones", func(t *testing.T) {
+		ev := &httpclient.StreamEvent{
+			Data: json.RawMessage(`{"id":"x","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"content":"a"},"finish_reason":""},{"index":1,"delta":{"content":"b"},"finish_reason":"length"}]}`),
+		}
+
+		out := normalizePassThroughFinishReason(ev)
+		require.Equal(t, gjson.Null, gjson.GetBytes(out.Data, "choices.0.finish_reason").Type)
+		require.Equal(t, "length", gjson.GetBytes(out.Data, "choices.1.finish_reason").String())
+	})
+
+	t.Run("nil and empty events pass through", func(t *testing.T) {
+		require.Nil(t, normalizePassThroughFinishReason(nil))
+
+		ev := &httpclient.StreamEvent{Data: []byte{}}
+		require.Same(t, ev, normalizePassThroughFinishReason(ev))
+	})
+}
