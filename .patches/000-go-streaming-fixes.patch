+// normalizePassThroughFinishReason rewrites an empty finish_reason string to null
+// in chat completion stream chunks delivered through pass-through. Some providers
+// (e.g. Sensenova) emit finish_reason:"" on every content chunk. That empty string
+// is not a valid finish_reason per the OpenAI spec (intermediate chunks must use
+// null), so strict clients fail to deserialize it. Rewriting "" -> null makes the
+// pass-through stream spec-compliant while leaving all other bytes untouched.
+func normalizePassThroughFinishReason(ev *httpclient.StreamEvent) *httpclient.StreamEvent {
+	if ev == nil || len(ev.Data) == 0 {
+		return ev
+	}
+
+	// Fast path: skip events that cannot carry a finish_reason field.
+	if !bytes.Contains(ev.Data, []byte("finish_reason")) {
+		return ev
+	}
+
+	if gjson.GetBytes(ev.Data, "object").String() != "chat.completion.chunk" {
+		return ev
+	}
+
+	choices := gjson.GetBytes(ev.Data, "choices")
+	if !choices.IsArray() {
+		return ev
+	}
+
+	body := ev.Data
+	rewritten := false
+	choices.ForEach(func(key, value gjson.Result) bool {
+		reason := value.Get("finish_reason")
+		if reason.Type != gjson.String || reason.String() != "" {
+			return true
+		}
+
+		var err error
+		body, err = sjson.SetBytes(body, "choices."+key.String()+".finish_reason", nil)
+		if err != nil {
+			return false
+		}
+		rewritten = true
+
+		return true
+	})
+
+	if !rewritten {
+		return ev
+	}
+
+	next := *ev
+	next.Data = body
+
+	return &next
+}
+
+// normalizePassThroughToolCallName rewrites an empty tool-call function name
+// string to null in chat completion stream chunks delivered through pass-through.
+// Some providers (e.g. UnionTech) emit the tool-call delta's function name only on
+// the first chunk and then repeat name:"" on every subsequent arguments chunk. An
+// empty string is not a valid function name per the OpenAI spec (intermediate chunks
+// must omit it or use null), so strict clients (e.g. Grok) fail to deserialize the
+// chunk and drop the whole tool call. Rewriting "" -> null makes the pass-through
+// stream spec-compliant while leaving all other bytes untouched.
+func normalizePassThroughToolCallName(ev *httpclient.StreamEvent) *httpclient.StreamEvent {
+	if ev == nil || len(ev.Data) == 0 {
+		return ev
+	}
+
+	// Fast path: skip events that cannot carry a tool_calls delta.
+	if !bytes.Contains(ev.Data, []byte("tool_calls")) {
+		return ev
+	}
+
+	if gjson.GetBytes(ev.Data, "object").String() != "chat.completion.chunk" {
+		return ev
+	}
+
+	choices := gjson.GetBytes(ev.Data, "choices")
+	if !choices.IsArray() {
+		return ev
+	}
+
+	body := ev.Data
+	rewritten := false
+	choices.ForEach(func(choiceKey, choiceValue gjson.Result) bool {
+		toolCalls := choiceValue.Get("delta.tool_calls")
+		if !toolCalls.IsArray() {
+			return true
+		}
+
+		toolCalls.ForEach(func(toolCallKey, toolCallValue gjson.Result) bool {
+			name := toolCallValue.Get("function.name")
+			if name.Type != gjson.String || name.String() != "" {
+				return true
+			}
+
+			var err error
+			body, err = sjson.SetBytes(body, "choices."+choiceKey.String()+".delta.tool_calls."+toolCallKey.String()+".function.name", nil)
+			if err != nil {
+				return false
+			}
+			rewritten = true
+
+			return true
+		})
+
+		return true
+	})
+
+	if !rewritten {
+		return ev
+	}
+
+	next := *ev
+	next.Data = body
+
+	return &next
+}
+
+// normalizePassThroughResponseStatus rewrites an empty response.status string to
+// "in_progress" in OpenAI Responses API stream events delivered through pass-through.
+// Some providers (e.g. UnionTech) emit response.created with status:"" instead of
+// "in_progress". Per the Responses API spec, status is an enum
+// (completed/failed/in_progress/cancelled/queued/incomplete) with no empty variant, so
+// strict clients (e.g. Grok) fail to deserialize the whole response. Rewriting "" ->
+// "in_progress" on response.created makes the pass-through stream spec-compliant while
+// leaving all other bytes untouched. Terminal events (response.completed / incomplete /
+// failed) carry valid status values and are never rewritten.
+func normalizePassThroughResponseStatus(ev *httpclient.StreamEvent) *httpclient.StreamEvent {
+	if ev == nil || len(ev.Data) == 0 {
+		return ev
+	}
+
+	// Fast path: only response.created carries the initial response.status.
+	if !bytes.Contains(ev.Data, []byte("response.created")) {
+		return ev
+	}
+
+	if gjson.GetBytes(ev.Data, "type").String() != "response.created" {
+		return ev
+	}
+
+	status := gjson.GetBytes(ev.Data, "response.status")
+	if status.Type != gjson.String || status.String() != "" {
+		return ev
+	}
+
+	body, err := sjson.SetBytes(ev.Data, "response.status", "in_progress")
+	if err != nil {
+		return ev
+	}
+
+	next := *ev
+	next.Data = body
+
+	return &next
+}
+
+// normalizePassThroughResponseOutput rewrites a null response.output to an empty
+// array in OpenAI Responses API stream events delivered through pass-through.
+// Some providers (e.g. UnionTech) emit response.created with output:null instead
+// of the spec-mandated empty array []. Per the Responses API spec, output is an
+// array of items ([] in response.created, populated by the time response.completed
+// arrives), so strict clients (e.g. Grok) fail to deserialize the whole response.
+// Rewriting null -> [] on response.created makes the pass-through stream
+// spec-compliant while leaving all other bytes untouched.
+func normalizePassThroughResponseOutput(ev *httpclient.StreamEvent) *httpclient.StreamEvent {
+	if ev == nil || len(ev.Data) == 0 {
+		return ev
+	}
+
+	// Fast path: only response.created carries the initial response.output.
+	if !bytes.Contains(ev.Data, []byte("response.created")) {
+		return ev
+	}
+
+	if gjson.GetBytes(ev.Data, "type").String() != "response.created" {
+		return ev
+	}
+
+	output := gjson.GetBytes(ev.Data, "response.output")
+	if output.Type != gjson.Null {
+		return ev
+	}
+
+	body, err := sjson.SetRawBytes(ev.Data, "response.output", []byte("[]"))
+	if err != nil {
+		return ev
+	}
+
+	next := *ev
+	next.Data = body
+
+	return &next
+}
+
+// normalizePassThroughSequenceNumber returns a stateful normalizer that injects a
+// monotonically increasing sequence_number into Responses API stream events that
+// omit it. The Responses API spec requires every SSE event to carry a
+// sequence_number (an integer starting at 0, incrementing by 1 per event), but
+// some providers (e.g. UnionTech) omit the field entirely, so strict clients
+// (e.g. Grok) fail to deserialize the event with "missing field sequence_number".
+// Injecting 0,1,2,... on each event that lacks the field makes the pass-through
+// stream spec-compliant while leaving all other bytes untouched. Events that
+// already carry a sequence_number are passed through unchanged, and the injected
+// counter stays aligned with the largest sequence_number seen so a
+// partially-compliant upstream does not create gaps.
+func normalizePassThroughSequenceNumber(seq *int) func(*httpclient.StreamEvent) *httpclient.StreamEvent {
+	return func(ev *httpclient.StreamEvent) *httpclient.StreamEvent {
+		if ev == nil || len(ev.Data) == 0 {
+			return ev
+		}
+
+		// Fast path: only Responses API events carry a sequence_number. Chat
+		// completion chunks must never be rewritten.
+		evType := gjson.GetBytes(ev.Data, "type").String()
+		if !strings.HasPrefix(evType, "response.") && evType != "error" {
+			return ev
+		}
+
+		// Keep the counter aligned with events that already carry a value, so a
+		// provider that emits sequence_number on some events but not others still
+		// produces a continuous stream.
+		if existing := gjson.GetBytes(ev.Data, "sequence_number"); existing.Exists() {
+			if n := existing.Int(); n >= int64(*seq) {
+				*seq = int(n) + 1
+			}
+
+			return ev
+		}
+
+		body, err := sjson.SetBytes(ev.Data, "sequence_number", *seq)
+		if err != nil {
+			return ev
+		}
+		*seq++
+
+		next := *ev
+		next.Data = body
+
+		return &next
+	}
+}
+
+// setPassThroughFieldIfMissing injects value at path unless the field already
+// exists with a non-null value. Returns the new body and whether it changed.
+func setPassThroughFieldIfMissing(data []byte, path string, value any) ([]byte, bool, error) {
+	existing := gjson.GetBytes(data, path)
+	if existing.Exists() && existing.Type != gjson.Null {
+		return data, false, nil
+	}
+
+	body, err := sjson.SetBytes(data, path, value)
+	if err != nil {
+		return data, false, err
+	}
+
+	return body, true, nil
+}
+
+// normalizePassThroughResponseRequiredFields injects spec-mandated required fields
+// into Responses API stream events that omit them, so strict clients (e.g. Grok)
+// do not fail deserialization with "missing field X". Some providers (e.g.
+// UnionTech) emit events that omit required fields such as the reasoning item's
+// summary, the response object's identity fields, output_text annotations, message
+// role/status, function-call name, and usage sub-fields. This rewrites only the
+// missing fields and leaves every existing byte untouched.
+func normalizePassThroughResponseRequiredFields(ev *httpclient.StreamEvent) *httpclient.StreamEvent {
+	if ev == nil || len(ev.Data) == 0 {
+		return ev
+	}
+
+	// Fast path: only Responses API events carry these fields.
+	evType := gjson.GetBytes(ev.Data, "type").String()
+	if !strings.HasPrefix(evType, "response.") && evType != "error" {
+		return ev
+	}
+
+	body := ev.Data
+	rewritten := false
+
+	// response.* events embed the full Response object.
+	if strings.HasPrefix(evType, "response.") && evType != "response.error" {
+		var err error
+		body, rewritten, err = normalizePassThroughResponseObject(body, evType)
+		if err != nil {
+			return ev
+		}
+	}
+
+	// output_item events carry an OutputItem.
+	if evType == "response.output_item.added" || evType == "response.output_item.done" {
+		var err error
+		body, rewritten, err = normalizePassThroughOutputItem(body, "item", evType == "response.output_item.done")
+		if err != nil {
+			return ev
+		}
+	}
+
+	// content_part events carry an OutputContent part.
+	if evType == "response.content_part.added" || evType == "response.content_part.done" {
+		var err error
+		body, rewritten, err = normalizePassThroughContentPart(body)
+		if err != nil {
+			return ev
+		}
+	}
+
+	// delta/done events share item_id/output_index/content_index.
+	if evType == "response.output_text.delta" || evType == "response.output_text.done" ||
+		evType == "response.reasoning_text.delta" || evType == "response.reasoning_text.done" ||
+		evType == "response.refusal.delta" || evType == "response.refusal.done" ||
+		evType == "response.function_call_arguments.delta" || evType == "response.function_call_arguments.done" ||
+		evType == "response.reasoning_summary_text.delta" || evType == "response.reasoning_summary_text.done" ||
+		evType == "response.reasoning_summary_part.added" || evType == "response.reasoning_summary_part.done" ||
+		evType == "response.custom_tool_call_input.delta" || evType == "response.custom_tool_call_input.done" ||
+		evType == "response.code_interpreter_call_code.delta" || evType == "response.code_interpreter_call_code.done" {
+		var err error
+		body, rewritten, err = normalizePassThroughCommonEventFields(body, evType)
+		if err != nil {
+			return ev
+		}
+	}
+
+	if !rewritten {
+		return ev
+	}
+
+	next := *ev
+	next.Data = body
+
+	return &next
+}
+
+// normalizePassThroughResponseObject ensures the Response object embedded in
+// response.* events carries all fields async-openai deserializes as required.
+func normalizePassThroughResponseObject(data []byte, evType string) ([]byte, bool, error) {
+	rewritten := false
+
+	var changed bool
+	var err error
+
+	for _, field := range []struct {
+		path  string
+		value any
+	}{
+		{"response.object", "response"},
+		{"response.id", "resp_passthrough"},
+		{"response.created_at", time.Now().Unix()},
+		{"response.model", "unknown"},
+	} {
+		data, changed, err = setPassThroughFieldIfMissing(data, field.path, field.value)
+		if err != nil {
+			return data, rewritten, err
+		}
+		rewritten = rewritten || changed
+	}
+
+	// status: infer a sensible value from the event type.
+	status := "in_progress"
+	switch evType {
+	case "response.completed":
+		status = "completed"
+	case "response.failed":
+		status = "failed"
+	case "response.incomplete":
+		status = "incomplete"
+	case "response.cancelled":
+		status = "cancelled"
+	case "response.queued":
+		status = "queued"
+	}
+	data, changed, err = setPassThroughFieldIfMissing(data, "response.status", status)
+	if err != nil {
+		return data, rewritten, err
+	}
+	rewritten = rewritten || changed
+
+	// output: empty array is the spec-mandated default.
+	data, changed, err = setPassThroughFieldIfMissing(data, "response.output", []any{})
+	if err != nil {
+		return data, rewritten, err
+	}
+	rewritten = rewritten || changed
+
+	// output[] items (e.g. reasoning items) also carry required per-type fields.
+	outputs := gjson.GetBytes(data, "response.output")
+	if outputs.IsArray() {
+		outputs.ForEach(func(key, _ gjson.Result) bool {
+			var itemErr error
+			data, changed, itemErr = normalizePassThroughOutputItem(data, "response.output."+key.String(), false)
+			if itemErr != nil {
+				err = itemErr
+				return false
+			}
+			rewritten = rewritten || changed
+			return true
+		})
+		if err != nil {
+			return data, rewritten, err
+		}
+	}
+
+	// usage: when present, its leaf fields are all required by async-openai.
+	if gjson.GetBytes(data, "response.usage").Exists() {
+		for _, field := range []struct {
+			path  string
+			value any
+		}{
+			{"response.usage.input_tokens", 0},
+			{"response.usage.output_tokens", 0},
+			{"response.usage.total_tokens", 0},
+			{"response.usage.input_tokens_details.cached_tokens", 0},
+			{"response.usage.output_tokens_details.reasoning_tokens", 0},
+		} {
+			data, changed, err = setPassThroughFieldIfMissing(data, field.path, field.value)
+			if err != nil {
+				return data, rewritten, err
+			}
+			rewritten = rewritten || changed
+		}
+	}
+
+	return data, rewritten, nil
+}
+
+// normalizePassThroughOutputItem ensures an output item (in output_item.added/done
+// events at prefix "item", or inside a response.output[] array) carries all fields
+// required by its type. prefix is the JSON path to the item, e.g. "item" or
+// "response.output.0".
+func normalizePassThroughOutputItem(data []byte, prefix string, isDone bool) ([]byte, bool, error) {
+	rewritten := false
+	itemType := gjson.GetBytes(data, prefix+".type").String()
+
+	var changed bool
+	var err error
+
+	switch itemType {
+	case "reasoning":
+		for _, field := range []struct {
+			name  string
+			value any
+		}{
+			{"summary", []any{}},
+			{"id", "rs_passthrough"},
+		} {
+			data, changed, err = setPassThroughFieldIfMissing(data, prefix+"."+field.name, field.value)
+			if err != nil {
+				return data, rewritten, err
+			}
+			rewritten = rewritten || changed
+		}
+		// Reasoning items may carry summary parts whose text is required.
+		data, changed, err = normalizePassThroughContentArrayParts(data, prefix+".summary")
+		if err != nil {
+			return data, rewritten, err
+		}
+		rewritten = rewritten || changed
+	case "message":
+		status := "in_progress"
+		if isDone {
+			status = "completed"
+		}
+		for _, field := range []struct {
+			name  string
+			value any
+		}{
+			{"content", []any{}},
+			{"id", "msg_passthrough"},
+			{"role", "assistant"},
+			{"status", status},
+		} {
+			data, changed, err = setPassThroughFieldIfMissing(data, prefix+"."+field.name, field.value)
+			if err != nil {
+				return data, rewritten, err
+			}
+			rewritten = rewritten || changed
+		}
+		// Message content parts (output_text) require text and annotations.
+		data, changed, err = normalizePassThroughContentArrayParts(data, prefix+".content")
+		if err != nil {
+			return data, rewritten, err
+		}
+		rewritten = rewritten || changed
+	case "function_call":
+		for _, field := range []struct {
+			name  string
+			value any
+		}{
+			{"name", ""},
+			{"call_id", ""},
+			{"arguments", ""},
+			{"id", "fc_passthrough"},
+		} {
+			data, changed, err = setPassThroughFieldIfMissing(data, prefix+"."+field.name, field.value)
+			if err != nil {
+				return data, rewritten, err
+			}
+			rewritten = rewritten || changed
+		}
+	default:
+		// Other item types: at minimum ensure an id exists so enum/tagged
+		// deserialization does not fail on an anonymous item.
+		if !gjson.GetBytes(data, prefix+".id").Exists() {
+			data, changed, err = setPassThroughFieldIfMissing(data, prefix+".id", "item_passthrough")
+			if err != nil {
+				return data, rewritten, err
+			}
+			rewritten = rewritten || changed
+		}
+	}
+
+	return data, rewritten, nil
+}
+
+// normalizePassThroughContentPart ensures output_text parts carry annotations and text.
+func normalizePassThroughContentPart(data []byte) ([]byte, bool, error) {
+	rewritten := false
+	partType := gjson.GetBytes(data, "part.type").String()
+
+	var changed bool
+	var err error
+
+	switch partType {
+	case "output_text":
+		for _, field := range []struct {
+			path  string
+			value any
+		}{
+			{"part.annotations", []any{}},
+			{"part.text", ""},
+		} {
+			data, changed, err = setPassThroughFieldIfMissing(data, field.path, field.value)
+			if err != nil {
+				return data, rewritten, err
+			}
+			rewritten = rewritten || changed
+		}
+	case "refusal":
+		data, changed, err = setPassThroughFieldIfMissing(data, "part.refusal", "")
+		if err != nil {
+			return data, rewritten, err
+		}
+		rewritten = rewritten || changed
+	case "reasoning_text":
+		data, changed, err = setPassThroughFieldIfMissing(data, "part.text", "")
+		if err != nil {
+			return data, rewritten, err
+		}
+		rewritten = rewritten || changed
+	case "summary_text":
+		data, changed, err = setPassThroughFieldIfMissing(data, "part.text", "")
+		if err != nil {
+			return data, rewritten, err
+		}
+		rewritten = rewritten || changed
+	}
+
+	return data, rewritten, nil
+}
+
+// normalizePassThroughContentArrayParts walks a content or summary array (message
+// content[] parts, reasoning summary[] parts) and injects the per-part-type required
+// fields (output_text.text/annotations, refusal.refusal, summary_text.text).
+func normalizePassThroughContentArrayParts(data []byte, arrayPath string) ([]byte, bool, error) {
+	rewritten := false
+	parts := gjson.GetBytes(data, arrayPath)
+	if !parts.IsArray() {
+		return data, rewritten, nil
+	}
+
+	var err error
+	parts.ForEach(func(key, _ gjson.Result) bool {
+		var changed bool
+		data, changed, err = normalizePassThroughContentPartAt(data, arrayPath+"."+key.String())
+		rewritten = rewritten || changed
+		return err == nil
+	})
+
+	return data, rewritten, err
+}
+
+// normalizePassThroughContentPartAt injects required fields into a single content
+// part located at the given JSON path (e.g. "item.content.0").
+func normalizePassThroughContentPartAt(data []byte, partPath string) ([]byte, bool, error) {
+	rewritten := false
+	partType := gjson.GetBytes(data, partPath+".type").String()
+
+	var changed bool
+	var err error
+
+	switch partType {
+	case "output_text":
+		for _, field := range []struct {
+			name  string
+			value any
+		}{
+			{"annotations", []any{}},
+			{"text", ""},
+		} {
+			data, changed, err = setPassThroughFieldIfMissing(data, partPath+"."+field.name, field.value)
+			if err != nil {
+				return data, rewritten, err
+			}
+			rewritten = rewritten || changed
+		}
+	case "refusal":
+		data, changed, err = setPassThroughFieldIfMissing(data, partPath+".refusal", "")
+		if err != nil {
+			return data, rewritten, err
+		}
+		rewritten = rewritten || changed
+	case "summary_text", "reasoning_text":
+		data, changed, err = setPassThroughFieldIfMissing(data, partPath+".text", "")
+		if err != nil {
+			return data, rewritten, err
+		}
+		rewritten = rewritten || changed
+	}
+
+	return data, rewritten, nil
+}
+
+// normalizePassThroughCommonEventFields ensures the shared index fields
+// (item_id/output_index/content_index) and the event-type-specific payload field
+// exist on delta/done events. Different event types carry different required
+// payload fields (text, delta, arguments, refusal, input, code); without them,
+// strict clients (e.g. Grok) fail deserialization with "missing field X".
+func normalizePassThroughCommonEventFields(data []byte, evType string) ([]byte, bool, error) {
+	rewritten := false
+
+	var changed bool
+	var err error
+
+	for _, field := range []struct {
+		path  string
+		value any
+	}{
+		{"item_id", ""},
+		{"output_index", 0},
+	} {
+		data, changed, err = setPassThroughFieldIfMissing(data, field.path, field.value)
+		if err != nil {
+			return data, rewritten, err
+		}
+		rewritten = rewritten || changed
+	}
+
+	// content_index is carried by text/refusal delta-done events but not by
+	// function_call_arguments / custom_tool_call_input / code_interpreter events.
+	if evType == "response.output_text.delta" || evType == "response.output_text.done" ||
+		evType == "response.reasoning_text.delta" || evType == "response.reasoning_text.done" ||
+		evType == "response.refusal.delta" || evType == "response.refusal.done" ||
+		evType == "response.reasoning_summary_text.delta" || evType == "response.reasoning_summary_text.done" {
+		data, changed, err = setPassThroughFieldIfMissing(data, "content_index", 0)
+		if err != nil {
+			return data, rewritten, err
+		}
+		rewritten = rewritten || changed
+	}
+
+	// Event-type-specific required payload field.
+	payloadField := ""
+	switch evType {
+	case "response.output_text.delta", "response.reasoning_text.delta",
+		"response.refusal.delta", "response.reasoning_summary_text.delta",
+		"response.function_call_arguments.delta",
+		"response.custom_tool_call_input.delta",
+		"response.code_interpreter_call_code.delta":
+		payloadField = "delta"
+	case "response.output_text.done", "response.reasoning_text.done",
+		"response.reasoning_summary_text.done":
+		payloadField = "text"
+	case "response.refusal.done":
+		payloadField = "refusal"
+	case "response.function_call_arguments.done":
+		payloadField = "arguments"
+	case "response.custom_tool_call_input.done":
+		payloadField = "input"
+	case "response.code_interpreter_call_code.done":
+		payloadField = "code"
+	}
+	if payloadField != "" {
+		data, changed, err = setPassThroughFieldIfMissing(data, payloadField, "")
+		if err != nil {
+			return data, rewritten, err
+		}
+		rewritten = rewritten || changed
+	}
+
+	return data, rewritten, nil
+}
