+func TestInboundTransformer_TransformStream_SynthesizesFinishReason(t *testing.T) {
+	transformer := NewInboundTransformer()
+
+	t.Run("tool call chunk stays non-terminal and usage-only chunk gets tool_calls", func(t *testing.T) {
+		stream, err := transformer.TransformStream(t.Context(), streams.SliceStream([]*llm.Response{
+			{
+				ID:      "chatcmpl-123",
+				Object:  "chat.completion.chunk",
+				Created: 1677652288,
+				Model:   "gpt-4",
+				Choices: []llm.Choice{
+					{
+						Index: 0,
+						Delta: &llm.Message{
+							Role: "assistant",
+							ToolCalls: []llm.ToolCall{
+								{
+									ID:   "call_123",
+									Type: "function",
+									Function: llm.FunctionCall{
+										Name: "get_user_city",
+									},
+									Index: 0,
+								},
+							},
+						},
+					},
+				},
+			},
+			{
+				ID:      "chatcmpl-123",
+				Object:  "chat.completion.chunk",
+				Created: 1677652289,
+				Model:   "gpt-4",
+				Choices: []llm.Choice{},
+				Usage: &llm.Usage{
+					PromptTokens:     10,
+					CompletionTokens: 20,
+					TotalTokens:      30,
+				},
+			},
+			{
+				Object: "[DONE]",
+			},
+		}))
+		require.NoError(t, err)
+
+		var events []*httpclient.StreamEvent
+		for stream.Next() {
+			events = append(events, stream.Current())
+		}
+		require.NoError(t, stream.Err())
+		require.Len(t, events, 3) // tool call chunk + usage chunk + [DONE]
+
+		var toolCallChunk llm.Response
+		require.NoError(t, json.Unmarshal(events[0].Data, &toolCallChunk))
+		require.Nil(t, toolCallChunk.Choices[0].FinishReason)
+
+		// Usage-only chunk gets the terminal reason after all tool-call data.
+		var usageChunk llm.Response
+		require.NoError(t, json.Unmarshal(events[1].Data, &usageChunk))
+		require.Len(t, usageChunk.Choices, 1)
+		require.NotNil(t, usageChunk.Choices[0].FinishReason)
+		require.Equal(t, "tool_calls", *usageChunk.Choices[0].FinishReason)
+	})
+
+	t.Run("usage-only chunk without prior tool calls gets stop as finish_reason", func(t *testing.T) {
+		stream, err := transformer.TransformStream(t.Context(), streams.SliceStream([]*llm.Response{
+			{
+				ID:      "chatcmpl-123",
+				Object:  "chat.completion.chunk",
+				Created: 1677652288,
+				Model:   "gpt-4",
+				Choices: []llm.Choice{
+					{
+						Index: 0,
+						Delta: &llm.Message{
+							Role: "assistant",
+							Content: llm.MessageContent{
+								Content: lo.ToPtr("Hello"),
+							},
+						},
+					},
+				},
+			},
+			{
+				ID:      "chatcmpl-123",
+				Object:  "chat.completion.chunk",
+				Created: 1677652289,
+				Model:   "gpt-4",
+				Choices: []llm.Choice{},
+				Usage: &llm.Usage{
+					PromptTokens:     10,
+					CompletionTokens: 20,
+					TotalTokens:      30,
+				},
+			},
+			{
+				Object: "[DONE]",
+			},
+		}))
+		require.NoError(t, err)
+
+		var events []*httpclient.StreamEvent
+		for stream.Next() {
+			events = append(events, stream.Current())
+		}
+		require.NoError(t, stream.Err())
+		require.Len(t, events, 3) // text chunk + usage chunk + [DONE]
+
+		// Usage-only chunk (events[1]) without prior tool calls should get "stop"
+		var usageChunk llm.Response
+		require.NoError(t, json.Unmarshal(events[1].Data, &usageChunk))
+		require.Len(t, usageChunk.Choices, 1)
+		require.NotNil(t, usageChunk.Choices[0].FinishReason)
+		require.Equal(t, "stop", *usageChunk.Choices[0].FinishReason)
+	})
+
+	t.Run("usage-only chunk stays unchanged after upstream finish_reason", func(t *testing.T) {
+		hasSeenToolCalls := false
+		hasSeenFinishReason := false
+		ensureStreamFinishReason(&llm.Response{
+			Choices: []llm.Choice{{FinishReason: lo.ToPtr("stop")}},
+		}, &hasSeenToolCalls, &hasSeenFinishReason)
+
+		usageChunk := &llm.Response{
+			Choices: []llm.Choice{},
+			Usage:   &llm.Usage{TotalTokens: 30},
+		}
+		ensureStreamFinishReason(usageChunk, &hasSeenToolCalls, &hasSeenFinishReason)
+
+		require.Empty(t, usageChunk.Choices)
+	})
+}
