+	t.Run("valid response status stays unchanged", func(t *testing.T) {
+		ev := &httpclient.StreamEvent{
+			Data: json.RawMessage(`{"type":"response.created","response":{"id":"resp_1","object":"response","status":"in_progress"}}`),
+		}
+
+		out := normalizePassThroughResponseStatus(ev)
+		require.Same(t, ev, out)
+	})
+
+	t.Run("non created event stays unchanged", func(t *testing.T) {
+		ev := &httpclient.StreamEvent{
+			Data: json.RawMessage(`{"type":"response.completed","response":{"id":"resp_1","object":"response","status":"completed"}}`),
