+// normalizePassThroughResponseMessages normalizes an OpenAI Responses
+// pass-through body so strict providers accept it:
+//   - message ids must start with "msg_"; clients (e.g. coding agents) may
+//     generate their own id formats (bare hex, uuids). Rewriting the id
+//     (rather than dropping it) keeps the client's id space intact.
+//   - message items whose content carries no non-empty text (empty text
+//     parts, empty content arrays, empty string content) are stripped or
+//     dropped, because strict providers reject them with a 400001
+//     invalid_request_error (missing input.content.text). Empty text parts
+//     are removed; if no content remains, the whole message item is dropped.
+func normalizePassThroughResponseMessages(body []byte) []byte {
+	result := gjson.GetBytes(body, "input")
+	if !result.IsArray() {
+		return body
+	}
+
+	next := body
+	var dropParts []struct{ item, part int } // content parts to remove
+	var dropItems []int                      // message items to remove entirely
+
+	result.ForEach(func(key, value gjson.Result) bool {
+		if value.Get("type").String() != "message" {
+			return true
+		}
+
+		itemIdx := int(key.Int())
+
+		// Rewrite non-conforming message ids.
+		id := value.Get("id")
+		if id.Type == gjson.String && id.String() != "" && !strings.HasPrefix(id.String(), "msg_") {
+			var err error
+			next, err = sjson.SetBytes(next, "input."+key.String()+".id", "msg_"+id.String())
+			if err != nil {
+				return false
+			}
+		}
+
+		// Strip empty-text content parts; drop the item when nothing remains.
+		content := value.Get("content")
+		switch {
+		case content.Type == gjson.String && strings.TrimSpace(content.String()) == "":
+			dropItems = append(dropItems, itemIdx)
+		case content.IsArray():
+			parts := content.Array()
+			var emptyParts []int
+			for i, part := range parts {
+				partType := part.Get("type").String()
+				if partType != "input_text" && partType != "output_text" {
+					continue
+				}
+				if strings.TrimSpace(part.Get("text").String()) == "" {
+					emptyParts = append(emptyParts, i)
+				}
+			}
+			switch {
+			case len(parts) == 0:
+				dropItems = append(dropItems, itemIdx)
+			case len(emptyParts) == len(parts):
+				dropItems = append(dropItems, itemIdx)
+			default:
+				for _, i := range emptyParts {
+					dropParts = append(dropParts, struct{ item, part int }{itemIdx, i})
+				}
+			}
+		}
+
+		return true
+	})
+
+	// Apply part removals with descending item/part indices so earlier indices stay valid.
+	sort.Slice(dropParts, func(a, b int) bool {
+		if dropParts[a].item != dropParts[b].item {
+			return dropParts[a].item > dropParts[b].item
+		}
+		return dropParts[a].part > dropParts[b].part
+	})
+	for _, r := range dropParts {
+		var err error
+		next, err = sjson.DeleteBytes(next, fmt.Sprintf("input.%d.content.%d", r.item, r.part))
+		if err != nil {
+			return body
+		}
+	}
+
+	sort.Sort(sort.Reverse(sort.IntSlice(dropItems)))
+	for _, i := range dropItems {
+		var err error
+		next, err = sjson.DeleteBytes(next, fmt.Sprintf("input.%d", i))
+		if err != nil {
+			return body
+		}
+	}
+
+	return next
+}
