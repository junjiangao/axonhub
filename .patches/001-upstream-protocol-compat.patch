+// normalizePassThroughFinishReason rewrites an empty finish_reason string to null
+// in chat completion stream chunks delivered through pass-through. Some providers
+// (e.g. Sensenova) emit finish_reason:"" on every content chunk. That empty string
+// is not a valid finish_reason per the OpenAI spec (intermediate chunks must use
+// null), so strict clients fail to deserialize it. Rewriting "" -> null makes the
+// pass-through stream spec-compliant while leaving all other bytes untouched.
+func normalizePassThroughFinishReason(ev *httpclient.StreamEvent) *httpclient.StreamEvent {
+	if ev == nil || len(ev.Data) == 0 {
+		return ev
+	}
+
+	// Fast path: skip events that cannot carry a finish_reason field.
+	if !bytes.Contains(ev.Data, []byte("finish_reason")) {
+		return ev
+	}
+
+	if gjson.GetBytes(ev.Data, "object").String() != "chat.completion.chunk" {
+		return ev
+	}
+
+	choices := gjson.GetBytes(ev.Data, "choices")
+	if !choices.IsArray() {
+		return ev
+	}
+
+	body := ev.Data
+	rewritten := false
+	choices.ForEach(func(key, value gjson.Result) bool {
+		reason := value.Get("finish_reason")
+		if reason.Type != gjson.String || reason.String() != "" {
+			return true
+		}
+
+		var err error
+		body, err = sjson.SetBytes(body, "choices."+key.String()+".finish_reason", nil)
+		if err != nil {
+			return false
+		}
+		rewritten = true
+
+		return true
+	})
+
+	if !rewritten {
+		return ev
+	}
+
+	next := *ev
+	next.Data = body
+
+	return &next
+}
+
+// normalizePassThroughToolCallName rewrites an empty tool-call function name
+// string to null in chat completion stream chunks delivered through pass-through.
+// Some providers emit the tool-call delta's function name only on
+// the first chunk and then repeat name:"" on every subsequent arguments chunk. An
+// empty string is not a valid function name per the OpenAI spec (intermediate chunks
+// must omit it or use null), so strict clients (e.g. Grok) fail to deserialize the
+// chunk and drop the whole tool call. Rewriting "" -> null makes the pass-through
+// stream spec-compliant while leaving all other bytes untouched.
+func normalizePassThroughToolCallName(ev *httpclient.StreamEvent) *httpclient.StreamEvent {
+	if ev == nil || len(ev.Data) == 0 {
+		return ev
+	}
+
+	// Fast path: skip events that cannot carry a tool_calls delta.
+	if !bytes.Contains(ev.Data, []byte("tool_calls")) {
+		return ev
+	}
+
+	if gjson.GetBytes(ev.Data, "object").String() != "chat.completion.chunk" {
+		return ev
+	}
+
+	choices := gjson.GetBytes(ev.Data, "choices")
+	if !choices.IsArray() {
+		return ev
+	}
+
+	body := ev.Data
+	rewritten := false
+	choices.ForEach(func(choiceKey, choiceValue gjson.Result) bool {
+		toolCalls := choiceValue.Get("delta.tool_calls")
+		if !toolCalls.IsArray() {
+			return true
+		}
+
+		toolCalls.ForEach(func(toolCallKey, toolCallValue gjson.Result) bool {
+			name := toolCallValue.Get("function.name")
+			if name.Type != gjson.String || name.String() != "" {
+				return true
+			}
+
+			var err error
+			body, err = sjson.SetBytes(body, "choices."+choiceKey.String()+".delta.tool_calls."+toolCallKey.String()+".function.name", nil)
+			if err != nil {
+				return false
+			}
+			rewritten = true
+
+			return true
+		})
+
+		return true
 	})
+
+	if !rewritten {
+		return ev
+	}
+
+	next := *ev
+	next.Data = body
+
+	return &next
 }
 
