diff --git a/docker-compose.override.yml b/docker-compose.override.yml
new file mode 100644
index 0000000..acf4e75
--- /dev/null
+++ b/docker-compose.override.yml
@@ -0,0 +1,73 @@
+# AxonHub 本地覆盖层 —— 由 docker compose 自动叠加在 docker-compose.yml 之上。
+#
+# 本文件由 .patches/002-local-changes.patch 创建（补丁集的一部分）：
+# 需要修改时请改补丁后重新执行 .patches/apply-patches.sh，不要就地编辑。
+#
+# 放在 override 而不是 docker-compose.yml 里，是为了让上游的 docker-compose.yml
+# 保持与 unstable 完全一致，本地构建/部署定制不再随上游改动而 rebase。
+#
+# 合并语义提示（实测 Compose v5.6.1）：
+# - environment 是映射合并，只需写差异键；
+# - command 与 healthcheck.test 是整体替换，healthcheck.test 必须写全，
+#   因此上游若调整健康检查参数，这里需要跟着同步。
+#
+# 出站代理：仅影响依赖环境变量代理的调用（版本检查、模型目录拉取、GitHub 相关）。
+# 渠道未显式配置代理时保持直连，不受这些变量影响。
+# 使用 AXONHUB_ 前缀变量名，避免被宿主机 shell 已导出的 HTTP_PROXY 等覆盖。
+# 若 Docker 无法解析 host-gateway，可通过 AXONHUB_HOST_GATEWAY 指定宿主机地址。
+
+services:
+  postgres:
+    container_name: axonhub-postgres
+    command:
+      - postgres
+      - -c
+      - timezone=${TZ:-Asia/Shanghai}
+      - -c
+      - log_timezone=${TZ:-Asia/Shanghai}
+      - -c
+      - shared_buffers=1GB
+      - -c
+      - effective_cache_size=2GB
+      - -c
+      - maintenance_work_mem=256MB
+      - -c
+      - max_wal_size=2GB
+      - -c
+      - max_connections=50
+    environment:
+      TZ: ${TZ:-Asia/Shanghai}
+    # 参数按清理后的 2-6 GB 数据库与峰值并发 ~10 取值；shared_buffers 与 max_connections
+    # 只在启动时读取，改完需要重建容器。宿主内存有限，用限额避免数据库无上限占用 page cache。
+    deploy:
+      resources:
+        limits:
+          cpus: "${POSTGRES_CPU_LIMIT:-2.0}"
+          memory: ${POSTGRES_MEMORY_LIMIT:-3G}
+
+  axonhub:
+    build:
+      context: .
+      dockerfile: Dockerfile
+      args:
+        VERSION: ${VERSION:-}
+      network: host
+    container_name: axonhub-app
+    environment:
+      TZ: ${TZ:-Asia/Shanghai}
+      HTTP_PROXY: ${AXONHUB_HTTP_PROXY:-}
+      HTTPS_PROXY: ${AXONHUB_HTTPS_PROXY:-}
+      NO_PROXY: ${AXONHUB_NO_PROXY:-localhost,127.0.0.1,::1,postgres,172.18.0.0/16,172.19.0.0/16}
+    extra_hosts: !override
+      - "host.docker.internal:${AXONHUB_HOST_GATEWAY:-host-gateway}"
+    healthcheck:
+      test:
+        [
+          "CMD",
+          "wget",
+          "--proxy=off",
+          "--no-verbose",
+          "--tries=1",
+          "--spider",
+          "http://localhost:8090/health",
+        ]
diff --git a/scripts/build-image.sh b/scripts/build-image.sh
new file mode 100755
index 0000000..92c0055
--- /dev/null
+++ b/scripts/build-image.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+#
+# build-image.sh — 构建本地 AxonHub 镜像并启动容器
+#
+# 用法（源码工作分支）:
+#   ./scripts/build-image.sh          # 构建镜像并启动 AxonHub
+#   ./scripts/build-image.sh --print  # 仅检查最终构建配置
+#
+set -euo pipefail
+
+if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != "--print" ]; }; then
+  echo "用法: $0 [--print]" >&2
+  exit 2
+fi
+
+REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$REPO_ROOT"
+
+if [ ! -f docker-compose.yml ]; then
+  echo "[!] 缺少 docker-compose.yml，请在源码工作分支执行。" >&2
+  exit 1
+fi
+
+BAKE_OPTIONS=(--file - --allow=network.host --load)
+if [ "${1:-}" = "--print" ]; then
+  BAKE_OPTIONS+=(--print)
+fi
+
+# Compose 负责读取 .env 和覆盖配置；导出失败时不会继续构建。
+BAKE_CONFIG=$(docker compose build --print axonhub)
+docker buildx bake "${BAKE_OPTIONS[@]}" axonhub <<< "$BAKE_CONFIG"
+
+if [ "${1:-}" != "--print" ]; then
+  docker compose up -d --no-build axonhub
+fi
