+/**
+ * Tier palette for chip-style rendering. A chip needs a surface that plain text
+ * colours do not provide: the fill paints the background at low alpha and the
+ * foreground doubles as text and border, so a tier reads the same in both
+ * themes. `neutral` has no foreground token and borrows the muted surface.
+ */
+export const METRIC_COLOR_BADGE_CLASS: Record<MetricColorTier, string> = {
+  red: 'border-[color:var(--metric-tier-red-fg)]/40 bg-[color:var(--metric-tier-red-fill)]/15 text-[color:var(--metric-tier-red-fg)]',
+  yellow:
+    'border-[color:var(--metric-tier-yellow-fg)]/40 bg-[color:var(--metric-tier-yellow-fill)]/15 text-[color:var(--metric-tier-yellow-fg)]',
+  neutral: 'border-border bg-muted text-muted-foreground',
+  blue: 'border-[color:var(--metric-tier-blue-fg)]/40 bg-[color:var(--metric-tier-blue-fill)]/15 text-[color:var(--metric-tier-blue-fg)]',
+  green:
+    'border-[color:var(--metric-tier-green-fg)]/40 bg-[color:var(--metric-tier-green-fill)]/15 text-[color:var(--metric-tier-green-fg)]',
+};
+
 const HIGHER_IS_BETTER_TIERS: MetricColorTier[] = ['red', 'yellow', 'neutral', 'blue', 'green'];
 const LOWER_IS_BETTER_TIERS: MetricColorTier[] = ['green', 'blue', 'neutral', 'yellow', 'red'];
 
