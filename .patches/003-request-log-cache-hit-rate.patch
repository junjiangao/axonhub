   return METRIC_COLOR_TEXT_CLASS[metricColorTier(key, rule, value)];
 }
 
+/**
+ * Chip class for a value, or an empty string when the metric is switched off so
+ * the caller keeps the neutral badge look instead of forcing a colour.
+ */
+export function metricColorBadgeClass(settings: MetricColorSettings, key: MetricColorKey, value: number | null | undefined): string {
+  const rule = settings[key];
+  if (!rule?.enabled || value === null || value === undefined || !Number.isFinite(value)) return '';
+
+  return METRIC_COLOR_BADGE_CLASS[metricColorTier(key, rule, value)];
+}
+
 function isFiniteNumber(value: unknown): value is number {
   return typeof value === 'number' && Number.isFinite(value);
 }
