 // WithProxy returns a new HttpClient that uses the given proxy configuration,
-// while preserving all other options (e.g., InsecureSkipVerify) from the original client.
+// while preserving the original client's transport settings (including any
+// custom RoundTripper) from the original client.
 func (hc *HttpClient) WithProxy(proxyConfig *ProxyConfig) *HttpClient {
-	return NewHttpClientWithProxy(proxyConfig, hc.opts...)
+	if hc == nil {
+		return NewHttpClientWithProxy(proxyConfig)
+	}
+	if hc.client == nil {
+		return NewHttpClientWithProxy(proxyConfig, hc.opts...)
+	}
+
+	proxyFunc := getProxyFunc(proxyConfig)
+	disableConnectionReuse := proxyConfig != nil &&
+		proxyConfig.Type == ProxyTypeURL &&
+		proxyConfig.DisableConnectionReuse
+
+	// Preserve the original transport so custom RoundTrippers (e.g., test
+	// mocks) and transport tuning survive the proxy switch. When the transport
+	// is nil (default client) or a plain *http.Transport, clone it and apply
+	// the proxy so the configured proxy actually takes effect.
+	if transport, ok := hc.client.Transport.(*http.Transport); ok {
+		cloned := transport.Clone()
+		cloned.Proxy = proxyFunc
+		if disableConnectionReuse {
+			cloned.DisableKeepAlives = true
+			cloned.ForceAttemptHTTP2 = false
+		}
+		return &HttpClient{
+			client:      &http.Client{Transport: cloned},
+			proxyConfig: proxyConfig,
+			opts:        hc.opts,
+		}
+	}
+
+	if hc.client.Transport == nil {
+		var base *http.Transport
+		if defaultTransport, ok := http.DefaultTransport.(*http.Transport); ok {
+			base = defaultTransport
+		} else {
+			// Fall back to a transport close to http.DefaultTransport when it has been replaced.
+			base = &http.Transport{
+				Proxy: proxyFunc,
+				DialContext: (&net.Dialer{
+					Timeout:   30 * time.Second,
+					KeepAlive: 30 * time.Second,
+				}).DialContext,
+				ForceAttemptHTTP2:     true,
+				MaxIdleConns:          100,
+				IdleConnTimeout:       90 * time.Second,
+				TLSHandshakeTimeout:   10 * time.Second,
+				ExpectContinueTimeout: 1 * time.Second,
+			}
+		}
+
+		cloned := base.Clone()
+		cloned.Proxy = proxyFunc
+		if disableConnectionReuse {
+			cloned.DisableKeepAlives = true
+			cloned.ForceAttemptHTTP2 = false
+		}
+		return &HttpClient{
+			client:      &http.Client{Transport: cloned},
+			proxyConfig: proxyConfig,
+			opts:        hc.opts,
+		}
+	}
+
+	return &HttpClient{
+		client:      hc.client,
+		proxyConfig: proxyConfig,
+		opts:        hc.opts,
+	}
