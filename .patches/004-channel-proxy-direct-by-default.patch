+type roundTripperFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripperFunc) RoundTrip(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
+
+func TestWithProxy_PreservesTransport(t *testing.T) {
+	t.Run("client settings and downgrade protection survive proxy switches", func(t *testing.T) {
+		for _, transport := range []http.RoundTripper{
+			nil,
+			http.DefaultTransport.(*http.Transport).Clone(),
+			roundTripperFunc(func(*http.Request) (*http.Response, error) { return nil, nil }),
+		} {
+			var redirectCalled bool
+			native := &http.Client{
+				Transport: transport,
+				Timeout:   17 * time.Second,
+				CheckRedirect: func(*http.Request, []*http.Request) error {
+					redirectCalled = true
+					return http.ErrUseLastResponse
+				},
+			}
+			hc := NewHttpClientWithClient(native).WithRejectHTTPSDowngrade()
+			for _, config := range []*ProxyConfig{
+				{Type: ProxyTypeDisabled},
+				{Type: ProxyTypeURL, URL: "http://proxy.example.com:8080"},
+				{Type: ProxyTypeEnvironment},
+			} {
+				hc = hc.WithProxy(config)
+				require.True(t, hc.rejectHTTPSDowngrade)
+				require.Equal(t, native.Timeout, hc.GetNativeClient().Timeout)
+				previous := httptest.NewRequest(http.MethodGet, "https://example.com", nil)
+				next := httptest.NewRequest(http.MethodGet, "http://example.com", nil)
+				require.ErrorContains(t, hc.GetNativeClient().CheckRedirect(next, []*http.Request{previous}), "refusing HTTPS to HTTP redirect")
+				require.False(t, redirectCalled)
+				next = httptest.NewRequest(http.MethodGet, "https://example.com/next", nil)
+				require.ErrorIs(t, hc.GetNativeClient().CheckRedirect(next, []*http.Request{previous}), http.ErrUseLastResponse)
+				require.True(t, redirectCalled)
+				redirectCalled = false
+				hc.CloseIdleConnections()
+			}
+		}
+	})
+
+	t.Run("URL proxy applies to default transport", func(t *testing.T) {
+		hc := NewHttpClient()
+		proxied := hc.WithProxy(&ProxyConfig{Type: ProxyTypeURL, URL: "http://proxy.example.com:8080"})
+		defer proxied.CloseIdleConnections()
+
+		transport, ok := proxied.GetNativeClient().Transport.(*http.Transport)
+		require.True(t, ok)
+		proxyURL, err := transport.Proxy(&http.Request{URL: &url.URL{Scheme: "https", Host: "api.example.com"}})
+		require.NoError(t, err)
+		require.NotNil(t, proxyURL)
+		require.Equal(t, "http://proxy.example.com:8080", proxyURL.String())
+	})
+
+	t.Run("disabled proxy bypasses", func(t *testing.T) {
+		hc := NewHttpClient()
+		proxied := hc.WithProxy(&ProxyConfig{Type: ProxyTypeDisabled})
+		defer proxied.CloseIdleConnections()
+
+		transport, ok := proxied.GetNativeClient().Transport.(*http.Transport)
+		require.True(t, ok)
+		proxyURL, err := transport.Proxy(&http.Request{URL: &url.URL{Scheme: "https", Host: "api.example.com"}})
+		require.NoError(t, err)
+		require.Nil(t, proxyURL)
+	})
+
+	t.Run("custom RoundTripper preserved", func(t *testing.T) {
+		var called atomic.Bool
+		rt := roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+			called.Store(true)
+			return &http.Response{
+				StatusCode: http.StatusOK,
+				Header:     make(http.Header),
+				Body:       io.NopCloser(strings.NewReader(`{}`)),
+				Request:    req,
+			}, nil
+		})
+		hc := NewHttpClientWithClient(&http.Client{Transport: rt})
+		proxied := hc.WithProxy(&ProxyConfig{Type: ProxyTypeURL, URL: "http://proxy.example.com:8080"})
+
+		resp, err := proxied.Do(context.Background(), &Request{Method: http.MethodGet, URL: "https://api.example.com/v1/responses"})
+		require.NoError(t, err)
+		require.Equal(t, http.StatusOK, resp.StatusCode)
+		require.True(t, called.Load(), "custom round tripper should have been used")
+	})
+
+	t.Run("URL-only connection reuse restriction does not leak across switches", func(t *testing.T) {
+		hc := NewHttpClientWithProxy(&ProxyConfig{
+			Type:                   ProxyTypeURL,
+			URL:                    "http://proxy.example.com:8080",
+			DisableConnectionReuse: true,
+		})
+		direct := hc.WithProxy(&ProxyConfig{Type: ProxyTypeDisabled})
+		defer direct.CloseIdleConnections()
+
+		transport, ok := direct.GetNativeClient().Transport.(*http.Transport)
+		require.True(t, ok)
+		require.False(t, transport.DisableKeepAlives)
+		require.True(t, transport.ForceAttemptHTTP2)
+	})
+}
