+func TestReplaceDeveloperRoleWithSystemInRawBody(t *testing.T) {
+	tests := []struct {
+		name      string
+		body      string
+		apiFormat llm.APIFormat
+		want      string
+	}{
+		{
+			name:      "chat completions replaces developer with system",
+			body:      `{"model":"glm-5.3-flash","messages":[{"role":"developer","content":"instructions"},{"role":"user","content":"hi"}]}`,
+			apiFormat: llm.APIFormatOpenAIChatCompletion,
+			want:      `{"model":"glm-5.3-flash","messages":[{"role":"system","content":"instructions"},{"role":"user","content":"hi"}]}`,
+		},
+		{
+			name:      "case insensitive role match",
+			body:      `{"model":"m","messages":[{"role":"Developer","content":"a"}]}`,
+			apiFormat: llm.APIFormatOpenAIChatCompletion,
+			want:      `{"model":"m","messages":[{"role":"system","content":"a"}]}`,
+		},
+		{
+			name:      "array content untouched",
+			body:      `{"model":"m","messages":[{"role":"developer","content":[{"type":"text","text":"a"}]}]}`,
+			apiFormat: llm.APIFormatOpenAIChatCompletion,
+			want:      `{"model":"m","messages":[{"role":"system","content":[{"type":"text","text":"a"}]}]}`,
+		},
+		{
+			name:      "no developer message returns body unchanged",
+			body:      `{"model":"m","messages":[{"role":"system","content":"a"},{"role":"user","content":"b"}]}`,
+			apiFormat: llm.APIFormatOpenAIChatCompletion,
+			want:      `{"model":"m","messages":[{"role":"system","content":"a"},{"role":"user","content":"b"}]}`,
+		},
+		{
+			name:      "responses input message item replaced",
+			body:      `{"input":[{"type":"message","role":"developer","content":[{"type":"input_text","text":"a"}]},{"type":"message","role":"user","content":[{"type":"input_text","text":"b"}]}]}`,
+			apiFormat: llm.APIFormatOpenAIResponse,
+			want:      `{"input":[{"type":"message","role":"system","content":[{"type":"input_text","text":"a"}]},{"type":"message","role":"user","content":[{"type":"input_text","text":"b"}]}]}`,
+		},
+		{
+			name:      "responses non-message items untouched",
+			body:      `{"input":[{"type":"function_call","name":"f","arguments":"{}"},{"type":"message","role":"developer","content":[{"type":"input_text","text":"a"}]}]}`,
+			apiFormat: llm.APIFormatOpenAIResponseCompact,
+			want:      `{"input":[{"type":"function_call","name":"f","arguments":"{}"},{"type":"message","role":"system","content":[{"type":"input_text","text":"a"}]}]}`,
+		},
+		{
+			name:      "responses string input untouched",
+			body:      `{"input":"hello","model":"m"}`,
+			apiFormat: llm.APIFormatOpenAIResponse,
+			want:      `{"input":"hello","model":"m"}`,
+		},
+		{
+			name:      "unsupported format untouched",
+			body:      `{"messages":[{"role":"developer","content":"a"}]}`,
+			apiFormat: llm.APIFormatAnthropicMessage,
+			want:      `{"messages":[{"role":"developer","content":"a"}]}`,
+		},
+		{
+			name:      "non-json body untouched",
+			body:      "not json",
+			apiFormat: llm.APIFormatOpenAIChatCompletion,
+			want:      "not json",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := replaceDeveloperRoleWithSystemInRawBody([]byte(tt.body), tt.apiFormat)
+			require.Equal(t, tt.want, string(got))
+		})
+	}
+}
