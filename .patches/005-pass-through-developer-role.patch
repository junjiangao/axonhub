 }
 
+// replaceDeveloperRoleWithSystemInRawBody rewrites developer-role messages to
+// system in a raw request body so pass-through payloads honor the channel's
+// ReplaceDeveloperRoleWithSystem transform option. Chat Completions bodies
+// carry roles on messages[*].role; Responses bodies carry them on the role of
+// message items inside input[*]. Roles are matched case-insensitively,
+// mirroring replaceDeveloperRoleWithSystem. Unsupported formats, non-JSON
+// documents, and bodies without a matching array are returned unchanged.
+func replaceDeveloperRoleWithSystemInRawBody(body []byte, apiFormat llm.APIFormat) []byte {
+	path := ""
+	switch apiFormat {
+	case llm.APIFormatOpenAIChatCompletion:
+		path = "messages"
+	case llm.APIFormatOpenAIResponse, llm.APIFormatOpenAIResponseCompact:
+		path = "input"
+	default:
+		return body
+	}
+
+	result := gjson.GetBytes(body, path)
+	if !result.IsArray() {
+		return body
+	}
+
+	items := result.Array()
+	indexes := make([]int, 0, len(items))
+	for i, item := range items {
+		role := item.Get("role")
+		if role.Type == gjson.String && strings.EqualFold(role.String(), "developer") {
+			indexes = append(indexes, i)
+		}
+	}
+
+	if len(indexes) == 0 {
+		return body
+	}
+
+	next := body
+	// Apply from the end so earlier indices stay valid.
+	for i := len(indexes) - 1; i >= 0; i-- {
+		var err error
+		next, err = sjson.SetBytes(next, path+"."+strconv.Itoa(indexes[i])+".role", "system")
+		if err != nil {
+			return body
+		}
+	}
+
+	return next
+}
