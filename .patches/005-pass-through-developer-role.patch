+		// Bailian-compatible gateways) still receive system instead.
+		if channel.Settings != nil && channel.Settings.TransformOptions.ReplaceDeveloperRoleWithSystem {
+			body = replaceDeveloperRoleWithSystemInRawBody(body, llmReq.APIFormat)
