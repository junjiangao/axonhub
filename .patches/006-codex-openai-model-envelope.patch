@@ -65,6 +66,11 @@ func parseModelCatalog(body []byte, supplementImageModel, requireListVisibility
 			Visibility string `json:"visibility"`
 			Priority   int    `json:"priority"`
 		} `json:"models"`
+		// OpenAI-compatible relays answer the model listing endpoint with the
+		// standard {"data":[{"id":"..."}]} envelope instead of the catalog shape.
+		Data []struct {
+			ID string `json:"id"`
+		} `json:"data"`
 	}
 	if err := json.Unmarshal(body, &response); err != nil {
 		return nil, err
@@ -85,6 +91,25 @@ func parseModelCatalog(body []byte, supplementImageModel, requireListVisibility
 			models = append(models, model.Slug)
 		}
 	}
+
+	// Only fall back when the catalog shape yielded nothing, so a response that
+	// carries both shapes keeps the catalog semantics (visibility, priority).
+	if len(models) == 0 {
+		seen := make(map[string]struct{}, len(response.Data))
+		for _, model := range response.Data {
+			id := strings.TrimSpace(model.ID)
+			if id == "" {
+				continue
+			}
+			if _, ok := seen[id]; ok {
+				continue
+			}
+			seen[id] = struct{}{}
+			models = append(models, id)
+		}
+		imageModelIncluded = slices.Contains(models, "gpt-image-2")
+	}
+
 	if len(models) == 0 {
 		return nil, fmt.Errorf("Codex catalog has no visible models")
 	}
