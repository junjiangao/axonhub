+func TestModelCatalogAcceptsOpenAICompatibleEnvelope(t *testing.T) {
+	t.Run("third party", func(t *testing.T) {
+		// Given a relay answering with the standard OpenAI-compatible envelope.
+		body := []byte(`{"object":"list","data":[{"id":"gpt-5.6-sol","object":"model"},{"id":" gpt-5.6-terra "},{"id":"gpt-5.6-sol"},{"id":""}]}`)
+		// When the third-party catalog is parsed.
+		models, err := ParseThirdPartyModelCatalog(body)
+		// Then ids are trimmed, deduplicated and keep upstream order.
+		require.NoError(t, err)
+		require.Equal(t, []string{"gpt-5.6-sol", "gpt-5.6-terra"}, models)
+	})
+
+	t.Run("official supplements image model once", func(t *testing.T) {
+		// Given a fallback envelope that already lists the image model.
+		body := []byte(`{"data":[{"id":"gpt-image-2"},{"id":"gpt-5.6-sol"}]}`)
+		// When the official catalog is parsed.
+		models, err := ParseModelCatalog(body)
+		// Then the image model is not appended a second time.
+		require.NoError(t, err)
+		require.Equal(t, []string{"gpt-image-2", "gpt-5.6-sol"}, models)
+	})
+
+	t.Run("empty envelope", func(t *testing.T) {
+		// Given an envelope without usable ids, when it is parsed.
+		models, err := ParseThirdPartyModelCatalog([]byte(`{"data":[]}`))
+		// Then the original validation error is kept.
+		require.EqualError(t, err, "Codex catalog has no visible models")
+		require.Nil(t, models)
+	})
+}
