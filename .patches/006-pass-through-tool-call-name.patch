 }
 
+func TestNormalizePassThroughToolCallName(t *testing.T) {
+	t.Run("empty tool call function name becomes null", func(t *testing.T) {
+		ev := &httpclient.StreamEvent{
+			Data: json.RawMessage(`{"id":"x","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"id":"call_1","type":"function","function":{"name":"","arguments":"{\"path\":\"/\"}"}}]}}]}]}`),
+		}
+
+		out := normalizePassThroughToolCallName(ev)
+		require.NotSame(t, ev, out, "normalization must not mutate the original event")
+		require.Equal(t, gjson.Null, gjson.GetBytes(out.Data, "choices.0.delta.tool_calls.0.function.name").Type)
+		require.Equal(t, "call_1", gjson.GetBytes(out.Data, "choices.0.delta.tool_calls.0.id").String())
+		require.Equal(t, `{"path":"/"}`, gjson.GetBytes(out.Data, "choices.0.delta.tool_calls.0.function.arguments").String())
+	})
+
+	t.Run("valid tool call name stays unchanged", func(t *testing.T) {
+		ev := &httpclient.StreamEvent{
+			Data: json.RawMessage(`{"id":"x","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"id":"call_1","type":"function","function":{"name":"list_dir","arguments":""}}]}}]}]}`),
+		}
+
+		out := normalizePassThroughToolCallName(ev)
+		require.Same(t, ev, out)
+	})
+
+	t.Run("multiple tool calls normalize only empty names", func(t *testing.T) {
+		ev := &httpclient.StreamEvent{
+			Data: json.RawMessage(`{"id":"x","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"id":"a","type":"function","function":{"name":"","arguments":"{}"}},{"index":1,"id":"b","type":"function","function":{"name":"read_file","arguments":"{}"}}]}}]}]}`),
+		}
+
+		out := normalizePassThroughToolCallName(ev)
+		require.Equal(t, gjson.Null, gjson.GetBytes(out.Data, "choices.0.delta.tool_calls.0.function.name").Type)
+		require.Equal(t, "read_file", gjson.GetBytes(out.Data, "choices.0.delta.tool_calls.1.function.name").String())
+	})
+
+	t.Run("non chat-completion chunk stays unchanged", func(t *testing.T) {
+		ev := &httpclient.StreamEvent{
+			Data: json.RawMessage(`{"id":"x","object":"chat.completion","choices":[{"index":0,"message":{"tool_calls":[{"index":0,"id":"a","type":"function","function":{"name":"","arguments":"{}"}}]}}]}]}`),
+		}
+
+		out := normalizePassThroughToolCallName(ev)
+		require.Same(t, ev, out)
+	})
+
+	t.Run("event without tool_calls field stays unchanged", func(t *testing.T) {
+		ev := &httpclient.StreamEvent{
+			Data: json.RawMessage(`{"id":"x","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"content":"hi"}}]}`),
+		}
+
+		out := normalizePassThroughToolCallName(ev)
+		require.Same(t, ev, out)
+	})
+
+	t.Run("nil and empty events pass through", func(t *testing.T) {
+		require.Nil(t, normalizePassThroughToolCallName(nil))
+
+		ev := &httpclient.StreamEvent{Data: []byte{}}
+		require.Same(t, ev, normalizePassThroughToolCallName(ev))
+	})
+}
