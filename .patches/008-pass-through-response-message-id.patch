+// normalizePassThroughResponseMessageIDs rewrites non-conforming message item
+// ids in an OpenAI Responses pass-through body. The Responses protocol expects
+// message ids to start with "msg_"; clients (e.g. coding agents) may generate
+// their own id formats (bare hex, uuids). When such a body is passed through
+// verbatim, strict providers reject it with a 400001
+// invalid_request_error. Rewriting the id (rather than dropping it) keeps the
+// client's id space intact while making the payload spec-compliant.
+func normalizePassThroughResponseMessageIDs(body []byte) []byte {
+	result := gjson.GetBytes(body, "input")
+	if !result.IsArray() {
+		return body
+	}
+
+	next := body
+	result.ForEach(func(key, value gjson.Result) bool {
+		if value.Get("type").String() != "message" {
+			return true
+		}
+
+		id := value.Get("id")
+		if id.Type != gjson.String || id.String() == "" || strings.HasPrefix(id.String(), "msg_") {
+			return true
+		}
+
+		var err error
+		next, err = sjson.SetBytes(next, "input."+key.String()+".id", "msg_"+id.String())
+		if err != nil {
+			return false
+		}
+
+		return true
+	})
+
+	return next
+}
